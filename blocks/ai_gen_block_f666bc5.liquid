{% doc %}
  @prompt
    一个youtobe视频展示板块，电脑端展示三个视频，右边有箭头可以展示更多；手机端展示一个，右边有箭头可以显示更多
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-youtube-showcase-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-youtube-showcase__container-{{ ai_gen_id }} {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-youtube-showcase__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 30px;
  }

  .ai-youtube-showcase__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 10px;
  }

  .ai-youtube-showcase__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
  }

  .ai-youtube-showcase__carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-youtube-showcase__carousel-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.video_gap }}px;
    overflow: hidden;
  }

  .ai-youtube-showcase__video-item-{{ ai_gen_id }} {
    display: none;
    flex-direction: column;
    gap: 12px;
  }

  .ai-youtube-showcase__video-item-{{ ai_gen_id }}.active {
    display: flex;
  }

  .ai-youtube-showcase__video-item-{{ ai_gen_id }}:only-child {
    grid-column: 1 / -1;
    justify-self: center;
    width: min(100%, 760px);
  }

  .ai-youtube-showcase__carousel-wrapper-{{ ai_gen_id }}:has(.ai-youtube-showcase__video-item-{{ ai_gen_id }}:only-child)
    .ai-youtube-showcase__nav-button-{{ ai_gen_id }} {
    display: none;
  }

  .ai-youtube-showcase__video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    background-color: #000;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
  }

  .ai-youtube-showcase__video-wrapper-{{ ai_gen_id }} iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .ai-youtube-showcase__video-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.video_title_color }};
    margin: 0;
  }

  .ai-youtube-showcase__nav-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    background-color: {{ block.settings.arrow_background_color }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .ai-youtube-showcase__nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.arrow_hover_background_color }};
  }

  .ai-youtube-showcase__nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-youtube-showcase__nav-button-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
    fill: {{ block.settings.arrow_color }};
  }

  .ai-youtube-showcase__nav-button--prev-{{ ai_gen_id }} {
    left: -24px;
  }

  .ai-youtube-showcase__nav-button--next-{{ ai_gen_id }} {
    right: -24px;
  }

  .ai-youtube-showcase__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-youtube-showcase__empty-state-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    margin-bottom: 20px;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-youtube-showcase__carousel-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-youtube-showcase__nav-button--prev-{{ ai_gen_id }} {
      left: 10px;
    }

    .ai-youtube-showcase__nav-button--next-{{ ai_gen_id }} {
      right: 10px;
    }
  }
{% endstyle %}

<youtube-showcase-{{ ai_gen_id }}
  class="ai-youtube-showcase-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-youtube-showcase__container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.description != blank %}
      <div class="ai-youtube-showcase__header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-youtube-showcase__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <div class="ai-youtube-showcase__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% liquid
      assign has_videos = false
      for i in (1..9)
        assign video_url_key = 'video_url_' | append: i
        assign video_url = block.settings[video_url_key]
        if video_url != blank
          assign has_videos = true
          break
        endif
      endfor
    %}

    {% if has_videos %}
      <div class="ai-youtube-showcase__carousel-wrapper-{{ ai_gen_id }}">
        <div class="ai-youtube-showcase__carousel-{{ ai_gen_id }}">
          {% for i in (1..9) %}
            {% liquid
              assign video_url_key = 'video_url_' | append: i
              assign video_title_key = 'video_title_' | append: i
              assign video_url = block.settings[video_url_key]
              assign video_title = block.settings[video_title_key]
            %}

            {% if video_url != blank %}
              {% liquid
                assign video_id = ''
                if video_url contains 'youtube.com/watch?v='
                  assign video_id = video_url | split: 'v=' | last | split: '&' | first
                elsif video_url contains 'youtu.be/'
                  assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first
                elsif video_url contains 'youtube.com/embed/'
                  assign video_id = video_url | split: 'embed/' | last | split: '?' | first
                endif
              %}

              {% if video_id != blank %}
                <div class="ai-youtube-showcase__video-item-{{ ai_gen_id }}" data-index="{{ forloop.index0 }}">
                  <div class="ai-youtube-showcase__video-wrapper-{{ ai_gen_id }}">
                    <iframe
                      src="https://www.youtube.com/embed/{{ video_id }}"
                      title="{{ video_title | escape }}"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                      loading="lazy"
                    ></iframe>
                  </div>
                  {% if video_title != blank %}
                    <h3 class="ai-youtube-showcase__video-title-{{ ai_gen_id }}">{{ video_title }}</h3>
                  {% endif %}
                </div>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>

        <button
          class="ai-youtube-showcase__nav-button-{{ ai_gen_id }} ai-youtube-showcase__nav-button--prev-{{ ai_gen_id }}"
          aria-label="Previous videos"
          data-direction="prev"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
          </svg>
        </button>

        <button
          class="ai-youtube-showcase__nav-button-{{ ai_gen_id }} ai-youtube-showcase__nav-button--next-{{ ai_gen_id }}"
          aria-label="Next videos"
          data-direction="next"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
          </svg>
        </button>
      </div>
    {% else %}
      <div class="ai-youtube-showcase__empty-state-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <path d="M10 16.5l6-4.5-6-4.5v9zM12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
        </svg>
        <p>Add YouTube video URLs to display your video showcase</p>
      </div>
    {% endif %}
  </div>
</youtube-showcase-{{ ai_gen_id }}>

<script>
  (function() {
    class YoutubeShowcase{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.videosPerPage = 3;
      }

      connectedCallback() {
        this.videos = Array.from(this.querySelectorAll('.ai-youtube-showcase__video-item-{{ ai_gen_id }}'));
        this.prevButton = this.querySelector('.ai-youtube-showcase__nav-button--prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-youtube-showcase__nav-button--next-{{ ai_gen_id }}');

        if (this.videos.length === 0) return;

        this.updateVideosPerPage();
        this.showVideos();
        this.setupEventListeners();

        window.addEventListener('resize', () => {
          this.updateVideosPerPage();
          this.showVideos();
        });
      }

      updateVideosPerPage() {
        this.videosPerPage = window.innerWidth <= 749 ? 1 : 3;
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.navigate('prev'));
        }
        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.navigate('next'));
        }
      }

      navigate(direction) {
        if (direction === 'prev') {
          this.currentIndex = Math.max(0, this.currentIndex - this.videosPerPage);
        } else {
          this.currentIndex = Math.min(
            this.videos.length - this.videosPerPage,
            this.currentIndex + this.videosPerPage
          );
        }
        this.showVideos();
      }

      showVideos() {
        this.videos.forEach((video, index) => {
          if (index >= this.currentIndex && index < this.currentIndex + this.videosPerPage) {
            video.classList.add('active');
          } else {
            video.classList.remove('active');
          }
        });

        this.updateButtons();
      }

      updateButtons() {
        if (this.prevButton) {
          this.prevButton.disabled = this.currentIndex === 0;
        }
        if (this.nextButton) {
          this.nextButton.disabled = this.currentIndex >= this.videos.length - this.videosPerPage;
        }
      }
    }

    customElements.define('youtube-showcase-{{ ai_gen_id }}', YoutubeShowcase{{ ai_gen_id }});
  })();
</script>

