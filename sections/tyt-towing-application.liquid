
{% comment %}
  TYT Shop by Towing Application
  Compatible with Shopify Dawn 15.3.0
{% endcomment %}

<section
  id="tyt-app-{{ section.id }}"
  class="tyt-app"
  style="
    --app-bg: {{ section.settings.background_color }};
    --app-card-bg: {{ section.settings.card_background }};
    --app-text: {{ section.settings.text_color }};
    --app-accent: {{ section.settings.accent_color }};
    --app-cols: {{ section.settings.desktop_columns }};
    --app-mobile-cols: {{ section.settings.mobile_columns }};
    --app-gap: {{ section.settings.card_gap }}px;
    --app-top: {{ section.settings.padding_top }}px;
    --app-bottom: {{ section.settings.padding_bottom }}px;
    --app-radius: {{ section.settings.card_radius }}px;
    --app-ratio: {{ section.settings.image_ratio }};
  "
>
  <div class="tyt-app__container">

    {% if section.settings.heading != blank or section.settings.subtitle != blank %}
      <div class="tyt-app__heading">

        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading | escape }}</h2>
        {% endif %}

        {% if section.settings.subtitle != blank %}
          <p>{{ section.settings.subtitle | escape }}</p>
        {% endif %}

      </div>
    {% endif %}

    <div class="tyt-app__grid">

      {% for block in section.blocks %}
        {% liquid
          assign app_image = block.settings.image
          assign app_title = block.settings.title
          assign app_link = block.settings.link
          assign app_alt = block.settings.image_alt

          if app_alt == blank
            assign app_alt = app_title
          endif
        %}

        <div class="tyt-app__card" {{ block.shopify_attributes }}>

          {% if app_link != blank %}
            <a
              class="tyt-app__card-link"
              href="{{ app_link }}"
              aria-label="{{ app_title | default: 'Shop towing products' | escape }}"
            >
          {% else %}
            <div class="tyt-app__card-link">
          {% endif %}

              <div class="tyt-app__image-wrap">

                {% if app_image != blank %}
                  {{
                    app_image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '360, 540, 720, 900, 1200',
                      sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 50vw',
                      alt: app_alt,
                      class: 'tyt-app__image'
                  }}
                {% else %}
                  <div class="tyt-app__placeholder">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}

              </div>

              <div class="tyt-app__content">

                {% if app_title != blank %}
                  <h3>{{ app_title | escape }}</h3>
                {% endif %}

                {% if block.settings.description != blank %}
                  <p>{{ block.settings.description | escape }}</p>
                {% endif %}

                {% if block.settings.button_label != blank %}
                  <span class="tyt-app__button">
                    {{ block.settings.button_label | escape }}
                    <span aria-hidden="true">&rarr;</span>
                  </span>
                {% endif %}

              </div>

          {% if app_link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}

        </div>

      {% endfor %}

    </div>
  </div>
</section>

<style>
  #tyt-app-{{ section.id }} {
    width: 100%;
    background: var(--app-bg);
    padding-top: var(--app-top);
    padding-bottom: var(--app-bottom);
  }

  #tyt-app-{{ section.id }} *,
  #tyt-app-{{ section.id }} *::before,
  #tyt-app-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #tyt-app-{{ section.id }} .tyt-app__container {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 20px;
  }

  #tyt-app-{{ section.id }} .tyt-app__heading {
    text-align: center;
    margin-bottom: 26px;
  }

  #tyt-app-{{ section.id }} .tyt-app__heading h2 {
    font-family: var(--font-heading-family);
    font-size: 32px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--app-text);
    margin: 0 0 8px;
  }

  #tyt-app-{{ section.id }} .tyt-app__heading p {
    font-family: inherit;
    font-size: 15px;
    line-height: 1.5;
    color: #666;
    margin: 0;
  }

  #tyt-app-{{ section.id }} .tyt-app__grid {
    display: grid;
    grid-template-columns:
      repeat(var(--app-cols), minmax(0, 1fr));
    gap: var(--app-gap);
  }

  #tyt-app-{{ section.id }} .tyt-app__card {
    background: var(--app-card-bg);
    border-radius: var(--app-radius);
    overflow: hidden;
    min-width: 0;
    transition: box-shadow .25s ease;
  }

  #tyt-app-{{ section.id }} .tyt-app__card:hover {
    box-shadow: 0 8px 24px rgba(0,0,0,.09);
  }

  #tyt-app-{{ section.id }} .tyt-app__card-link {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  #tyt-app-{{ section.id }} a.tyt-app__card-link:focus-visible {
    outline: 3px solid var(--app-accent);
    outline-offset: -3px;
  }

  #tyt-app-{{ section.id }} .tyt-app__image-wrap {
    width: 100%;
    aspect-ratio: var(--app-ratio);
    background: #f5f5f5;
    overflow: hidden;
  }

  #tyt-app-{{ section.id }} .tyt-app__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    transition: transform .3s ease;
  }

  #tyt-app-{{ section.id }} .tyt-app__card:hover .tyt-app__image {
    transform: scale(1.04);
  }

  #tyt-app-{{ section.id }} .tyt-app__placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
  }

  #tyt-app-{{ section.id }} .tyt-app__placeholder svg {
    width: 70%;
    height: 70%;
  }

  #tyt-app-{{ section.id }} .tyt-app__content {
    padding: 16px 14px 20px;
    text-align: center;
  }

  #tyt-app-{{ section.id }} .tyt-app__content h3 {
    font-family: var(--font-heading-family);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.35;
    color: var(--app-text);
    margin: 0 0 8px;
  }

  #tyt-app-{{ section.id }} .tyt-app__content p {
    font-family: inherit;
    font-size: 13px;
    line-height: 1.5;
    color: #666;
    margin: 0 0 12px;
  }

  #tyt-app-{{ section.id }} .tyt-app__button {
    display: inline-block;
    font-size: 13px;
    font-weight: 700;
    color: var(--app-accent);
  }

  #tyt-app-{{ section.id }} .tyt-app__button span {
    margin-left: 4px;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    #tyt-app-{{ section.id }} .tyt-app__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #tyt-app-{{ section.id }} .tyt-app__container {
      padding: 0 12px;
    }

    #tyt-app-{{ section.id }} .tyt-app__grid {
      grid-template-columns:
        repeat(var(--app-mobile-cols), minmax(0, 1fr));
    }

    #tyt-app-{{ section.id }} .tyt-app__heading h2 {
      font-size: 26px;
    }

    #tyt-app-{{ section.id }} .tyt-app__content {
      padding: 12px 8px 16px;
    }

    #tyt-app-{{ section.id }} .tyt-app__content h3 {
      font-size: 15px;
    }

    #tyt-app-{{ section.id }} .tyt-app__content p {
      font-size: 12px;
    }

    #tyt-app-{{ section.id }} .tyt-app__button {
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #tyt-app-{{ section.id }} .tyt-app__card,
    #tyt-app-{{ section.id }} .tyt-app__image {
      transition: none;
    }
  }
</style>

{% schema %}
{
  "name": "TYT Towing Applications",
  "tag": "section",
  "class": "tyt-towing-applications",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Towing Application"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Find the right hitch for your towing needs."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "5/4", "label": "Landscape 5:4" },
        { "value": "4/3", "label": "Landscape 4:3" },
        { "value": "1/1", "label": "Square 1:1" },
        { "value": "16/9", "label": "Wide 16:9" }
      ],
      "default": "5/4"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image display",
      "options": [
        { "value": "cover", "label": "Fill image area" },
        { "value": "contain", "label": "Show full image" }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card spacing",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#F7F7F7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#202020"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Link color",
      "default": "#D71920"
    }
  ],
  "blocks": [
    {
      "type": "application_card",
      "name": "Application Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Scene image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Scene title",
          "default": "Towing Application"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Explore towing solutions."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Destination link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "TYT Towing Applications",
      "blocks": [
        {
          "type": "application_card",
          "settings": {
            "title": "Work & Equipment",
            "description": "Heavy-duty towing for tough jobs."
          }
        },
        {
          "type": "application_card",
          "settings": {
            "title": "Boat & Marine",
            "description": "Ready for your next adventure."
          }
        },
        {
          "type": "application_card",
          "settings": {
            "title": "RV & Camping",
            "description": "Explore more with confidence."
          }
        },
        {
          "type": "application_card",
          "settings": {
            "title": "Farm & Utility",
            "description": "Built for everyday hauling."
          }
        }
      ]
    }
  ]
}
{% endschema %}
