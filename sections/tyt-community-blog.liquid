
{% comment %}
  TYT Community & Impact Blog
  Auto displays articles from a Shopify blog.
  Compatible with Shopify Dawn.
{% endcomment %}

{% liquid
  assign community_blog = section.settings.blog
  if community_blog == blank
    assign community_blog = blogs['community-impact']
  endif

  assign article_count = 0
  if community_blog != blank
    assign article_count = community_blog.articles.size
  endif

  assign show_count = article_count
  if show_count > section.settings.article_limit
    assign show_count = section.settings.article_limit
  endif
%}

<section
  id="tyt-community-blog-{{ section.id }}"
  class="tyt-community-blog"
  style="
    --tyt-bg: {{ section.settings.background_color }};
    --tyt-card: {{ section.settings.card_color }};
    --tyt-text: {{ section.settings.text_color }};
    --tyt-red: {{ section.settings.accent_color }};
    --tyt-gap: {{ section.settings.card_gap }}px;
    --tyt-cols: {{ section.settings.desktop_columns }};
    --tyt-top: {{ section.settings.padding_top }}px;
    --tyt-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="tyt-community-blog__inner">

    <header class="tyt-community-blog__header">

      {% if section.settings.eyebrow != blank %}
        <p class="tyt-community-blog__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2>
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <p class="tyt-community-blog__subtitle">
          {{ section.settings.subtitle | escape }}
        </p>
      {% endif %}

    </header>

    {% if community_blog != blank and show_count > 0 %}

      <div
        class="tyt-community-blog__grid
        {% if show_count == 1 %}
          tyt-community-blog__grid--featured
        {% endif %}"
      >

        {% for article in community_blog.articles
          limit: section.settings.article_limit %}

          {% liquid
            assign cover = article.image
            assign summary = article.excerpt
            if summary == blank
              assign summary = article.content
            endif
          %}

          <article class="tyt-community-blog__card">

            <a
              href="{{ article.url }}"
              class="tyt-community-blog__image-link"
              aria-label="{{ article.title | escape }}"
            >

              <div class="tyt-community-blog__image">

                {% if cover != blank %}

                  {{
                    cover
                    | image_url: width: 1400
                    | image_tag:
                      loading: 'lazy',
                      widths: '360, 540, 750, 990, 1200, 1400',
                      sizes: '(min-width: 990px) 50vw, (min-width: 750px) 50vw, 100vw',
                      alt: article.title,
                      class: 'tyt-community-blog__photo'
                  }}

                {% elsif article.handle == 'tyt-at-colorado-4x4-offroad-event-2026' %}

                  <img
                    class="tyt-community-blog__photo"
                    src="https://cdn.shopify.com/s/files/1/0268/5442/4762/files/Colorado_4x4_Offroad_Event_2026_2.jpg?v=1793598481"
                    alt="Colorado 4x4 Offroad Event 2026 TYT award recipients"
                    loading="lazy"
                    width="1200"
                    height="800"
                  >

                {% else %}

                  <div class="tyt-community-blog__no-image">
                    <span>TYT COMMUNITY</span>
                  </div>

                {% endif %}

              </div>

            </a>

            <div class="tyt-community-blog__content">

              <div class="tyt-community-blog__meta">

                {% if section.settings.show_date %}
                  <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                    {{ article.published_at | date: '%b %d, %Y' }}
                  </time>
                {% endif %}

                {% if section.settings.show_category %}
                  <span class="tyt-community-blog__category">
                    COMMUNITY STORY
                  </span>
                {% endif %}

              </div>

              <h3>
                <a href="{{ article.url }}">
                  {{ article.title | escape }}
                </a>
              </h3>

              {% if section.settings.show_excerpt %}
                <p class="tyt-community-blog__excerpt">
                  {{
                    summary
                    | strip_html
                    | strip
                    | truncate: 155
                  }}
                </p>
              {% endif %}

              <a
                class="tyt-community-blog__readmore"
                href="{{ article.url }}"
              >
                {{ section.settings.read_more_label | escape }}
                <span aria-hidden="true">&rarr;</span>
              </a>

            </div>

          </article>

        {% endfor %}

      </div>

      {% if section.settings.show_view_all %}
        <div class="tyt-community-blog__footer">
          <a href="{{ community_blog.url }}">
            {{ section.settings.view_all_label | escape }}
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      {% endif %}

    {% elsif request.design_mode %}

      <div class="tyt-community-blog__empty">
        Select the Community & Impact blog
        and publish an article to display stories here.
      </div>

    {% endif %}

  </div>
</section>

<style>
  #tyt-community-blog-{{ section.id }} {
    background: var(--tyt-bg);
    color: var(--tyt-text);
    padding: var(--tyt-top) 0 var(--tyt-bottom);
    width: 100%;
  }

  #tyt-community-blog-{{ section.id }} *,
  #tyt-community-blog-{{ section.id }} *::before,
  #tyt-community-blog-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__inner {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Heading */

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__header {
    text-align: center;
    margin-bottom: 28px;
  }

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__eyebrow {
    color: var(--tyt-red);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    margin: 0 0 8px;
  }

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__header h2 {
    font-family: var(--font-heading-family);
    font-size: 32px;
    line-height: 1.25;
    font-weight: 700;
    color: var(--tyt-text);
    margin: 0 0 8px;
  }

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__subtitle {
    color: #666;
    font-size: 15px;
    line-height: 1.5;
    margin: 0;
  }

  /* Grid */

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__grid {
    display: grid;
    grid-template-columns: repeat(var(--tyt-cols), minmax(0, 1fr));
    gap: var(--tyt-gap);
  }

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__card {
    min-width: 0;
    overflow: hidden;
    background: var(--tyt-card);
    border-radius: 8px;
  }

  /* Images */

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__image-link {
    display: block;
    text-decoration: none;
  }

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__image {
    aspect-ratio: 16 / 10;
    width: 100%;
    overflow: hidden;
    background: #ededed;
  }

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .3s ease;
  }

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__card:hover .tyt-community-blog__photo {
    transform: scale(1.035);
  }

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__no-image {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--tyt-red);
    font-weight: 700;
    letter-spacing: 2px;
    font-size: 16px;
  }

  /* Text */

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__content {
    padding: 22px;
  }

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    font-size: 12px;
    color: #777;
  }

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__category {
    color: var(--tyt-red);
    font-weight: 700;
    letter-spacing: .7px;
  }

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__content h3 {
    font-family: var(--font-heading-family);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 12px;
  }

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__content h3 a {
    color: var(--tyt-text);
    text-decoration: none;
  }

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__excerpt {
    color: #666;
    font-size: 14px;
    line-height: 1.65;
    margin: 0 0 16px;
  }

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__readmore {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--tyt-red);
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
  }

  #tyt-community-blog-{{ section.id }} a:focus-visible {
    outline: 2px solid var(--tyt-red);
    outline-offset: 3px;
  }

  /* Featured single article layout */

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__grid--featured {
    grid-template-columns: minmax(0, 1fr);
  }

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__grid--featured .tyt-community-blog__card {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: stretch;
  }

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__grid--featured .tyt-community-blog__image {
    height: 100%;
    min-height: 340px;
    aspect-ratio: auto;
  }

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__grid--featured .tyt-community-blog__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 36px;
  }

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__grid--featured .tyt-community-blog__content h3 {
    font-size: 28px;
  }

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__grid--featured .tyt-community-blog__excerpt {
    font-size: 15px;
  }

  /* View all */

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__footer {
    text-align: center;
    margin-top: 26px;
  }

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__footer a {
    color: var(--tyt-red);
    text-decoration: none;
    font-size: 15px;
    font-weight: 700;
  }

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__footer a:hover,
  #tyt-community-blog-{{ section.id }} .tyt-community-blog__readmore:hover {
    text-decoration: underline;
  }

  #tyt-community-blog-{{ section.id }} .tyt-community-blog__empty {
    text-align: center;
    padding: 36px;
    background: #f5f5f5;
    color: #555;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    #tyt-community-blog-{{ section.id }} .tyt-community-blog__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #tyt-community-blog-{{ section.id }} .tyt-community-blog__grid--featured {
      grid-template-columns: minmax(0, 1fr);
    }

    #tyt-community-blog-{{ section.id }} .tyt-community-blog__grid--featured .tyt-community-blog__card {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    #tyt-community-blog-{{ section.id }} .tyt-community-blog__inner {
      padding: 0 12px;
    }

    #tyt-community-blog-{{ section.id }} .tyt-community-blog__header h2 {
      font-size: 26px;
    }

    #tyt-community-blog-{{ section.id }} .tyt-community-blog__subtitle {
      font-size: 14px;
    }

    #tyt-community-blog-{{ section.id }} .tyt-community-blog__grid,
    #tyt-community-blog-{{ section.id }} .tyt-community-blog__grid--featured {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }

    #tyt-community-blog-{{ section.id }} .tyt-community-blog__grid--featured .tyt-community-blog__card {
      display: block;
    }

    #tyt-community-blog-{{ section.id }} .tyt-community-blog__grid--featured .tyt-community-blog__image {
      min-height: 0;
      height: auto;
      aspect-ratio: 16 / 10;
    }

    #tyt-community-blog-{{ section.id }} .tyt-community-blog__content,
    #tyt-community-blog-{{ section.id }} .tyt-community-blog__grid--featured .tyt-community-blog__content {
      display: block;
      padding: 20px 16px;
    }

    #tyt-community-blog-{{ section.id }} .tyt-community-blog__content h3,
    #tyt-community-blog-{{ section.id }} .tyt-community-blog__grid--featured .tyt-community-blog__content h3 {
      font-size: 20px;
    }

    #tyt-community-blog-{{ section.id }} .tyt-community-blog__excerpt,
    #tyt-community-blog-{{ section.id }} .tyt-community-blog__grid--featured .tyt-community-blog__excerpt {
      font-size: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #tyt-community-blog-{{ section.id }} .tyt-community-blog__photo {
      transition: none;
    }
  }
</style>

{% schema %}
{
  "name": "TYT Community Blog",
  "tag": "section",
  "class": "tyt-community-blog-section",
  "settings": [
    {
      "type": "header",
      "content": "Blog source"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Choose community blog"
    },
    {
      "type": "range",
      "id": "article_limit",
      "label": "Number of articles",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "BEYOND THE TOW"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "TYT Community & Impact"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Real stories. Stronger communities. Beyond the tow."
    },
    {
      "type": "header",
      "content": "Article display"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show publish date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "Show community label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show article excerpt",
      "default": true
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "Read more text",
      "default": "Read the Story"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show all stories link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "All stories text",
      "default": "Explore All Community Stories"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#F7F7F7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#202020"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "TYT accent",
      "default": "#D71920"
    }
  ],
  "presets": [
    {
      "name": "TYT Community Blog"
    }
  ]
}
{% endschema %}
