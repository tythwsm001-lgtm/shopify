{% comment %}
  TYT Homepage Banner - Dawn 15.3 compatible custom section.
  Image-only slides: preserves existing artwork, without introducing a new font.
{% endcomment %}
{%- liquid
  assign slide_count = section.blocks.size
-%}
<section
  id="tyt-banner-{{ section.id }}"
  class="tyt-banner"
  style="--tyt-banner-desktop-ratio: {{ section.settings.desktop_ratio }}; --tyt-banner-mobile-ratio: {{ section.settings.mobile_ratio }}; --tyt-banner-max-width: {{ section.settings.max_width }}px; --tyt-banner-arrow-color: {{ section.settings.arrow_color }}; --tyt-banner-dot-color: {{ section.settings.dot_color }};"
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.interval | times: 1000 }}"
  aria-roledescription="carousel"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <div class="tyt-banner__outer">
    <div class="tyt-banner__viewport">
      <div class="tyt-banner__track">
        {%- for block in section.blocks -%}
          {%- assign desktop_image = block.settings.image -%}
          {%- assign mobile_image = block.settings.mobile_image | default: desktop_image -%}
          <div
            class="tyt-banner__slide"
            data-slide="{{ forloop.index0 }}"
            data-block-id="{{ block.id }}"
            role="group"
            aria-roledescription="slide"
            aria-label="{{ forloop.index }} of {{ slide_count }}"
            {% unless forloop.first %}aria-hidden="true" inert{% endunless %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.link != blank -%}
              <a class="tyt-banner__image-link" href="{{ block.settings.link }}" aria-label="{{ block.settings.link_label | default: 'View featured product' | escape }}">
            {%- else -%}
              <div class="tyt-banner__image-link">
            {%- endif -%}
              {%- if desktop_image != blank -%}
                <picture>
                  {%- if block.settings.mobile_image != blank -%}
                    <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1100 }} 1100w, {{ mobile_image | image_url: width: 1500 }} 1500w" sizes="100vw">
                  {%- endif -%}
                  <img
                    src="{{ desktop_image | image_url: width: 1800 }}"
                    srcset="{{ desktop_image | image_url: width: 750 }} 750w, {{ desktop_image | image_url: width: 1100 }} 1100w, {{ desktop_image | image_url: width: 1500 }} 1500w, {{ desktop_image | image_url: width: 1800 }} 1800w, {{ desktop_image | image_url: width: 2200 }} 2200w, {{ desktop_image | image_url: width: 2600 }} 2600w"
                    sizes="100vw"
                    width="{{ desktop_image.width }}"
                    height="{{ desktop_image.height }}"
                    alt="{{ block.settings.image_alt | escape }}"
                    {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
                    class="tyt-banner__image"
                  >
                </picture>
              {%- elsif block.settings.desktop_asset != blank -%}
                <picture>
                  {%- if block.settings.mobile_asset != blank -%}
                    <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_asset | asset_url }}">
                  {%- endif -%}
                  <img
                    src="{{ block.settings.desktop_asset | asset_url }}"
                    width="1672"
                    height="941"
                    alt="{{ block.settings.image_alt | escape }}"
                    {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
                    class="tyt-banner__image"
                  >
                </picture>
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'tyt-banner__placeholder' }}
              {%- endif -%}
            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      {%- if slide_count > 1 and section.settings.show_arrows -%}
        <button class="tyt-banner__arrow tyt-banner__arrow--prev" type="button" aria-label="Previous banner" data-prev>&#10094;</button>
        <button class="tyt-banner__arrow tyt-banner__arrow--next" type="button" aria-label="Next banner" data-next>&#10095;</button>
      {%- endif -%}
    </div>
    {%- if slide_count > 1 and section.settings.show_dots -%}
      <div class="tyt-banner__dots" aria-label="Choose a banner">
        {%- for block in section.blocks -%}
          <button type="button" class="tyt-banner__dot{% if forloop.first %} is-active{% endif %}" data-go="{{ forloop.index0 }}" aria-label="Go to banner {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"><span></span></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{% if request.page_type == 'index' %}
  {{ 'tyt-home-refresh.css' | asset_url | stylesheet_tag }}
{% endif %}

<style>
  #tyt-banner-{{ section.id }} { width:100%; }
  #tyt-banner-{{ section.id }} .tyt-banner__outer { max-width:var(--tyt-banner-max-width); margin:0 auto; }
  #tyt-banner-{{ section.id }} .tyt-banner__viewport { overflow:hidden; position:relative; }
  #tyt-banner-{{ section.id }} .tyt-banner__track { display:flex; transition:transform .45s ease; }
  #tyt-banner-{{ section.id }} .tyt-banner__slide { flex:0 0 100%; min-width:0; }
  #tyt-banner-{{ section.id }} .tyt-banner__image-link { display:block; width:100%; aspect-ratio:var(--tyt-banner-desktop-ratio); overflow:hidden; }
  #tyt-banner-{{ section.id }} .tyt-banner__image-link picture { display:block; width:100%; height:100%; }
  #tyt-banner-{{ section.id }} .tyt-banner__image,
  #tyt-banner-{{ section.id }} .tyt-banner__placeholder { display:block; width:100%; height:100%; object-fit:cover; }
  #tyt-banner-{{ section.id }} .tyt-banner__arrow { position:absolute; z-index:2; top:50%; transform:translateY(-50%); cursor:pointer; color:var(--tyt-banner-arrow-color); background:rgba(0,0,0,.22); border:0; width:44px; height:44px; font-size:24px; line-height:1; }
  #tyt-banner-{{ section.id }} .tyt-banner__arrow--prev { left:16px; }
  #tyt-banner-{{ section.id }} .tyt-banner__arrow--next { right:16px; }
  #tyt-banner-{{ section.id }} .tyt-banner__dots { display:flex; align-items:center; justify-content:center; gap:6px; padding:8px 0; }
  #tyt-banner-{{ section.id }} .tyt-banner__dot { display:grid; place-items:center; padding:7px; border:0; background:transparent; cursor:pointer; }
  #tyt-banner-{{ section.id }} .tyt-banner__dot span { display:block; width:8px; height:8px; border-radius:50%; border:1px solid var(--tyt-banner-dot-color); }
  #tyt-banner-{{ section.id }} .tyt-banner__dot.is-active span { background:var(--tyt-banner-dot-color); }
  #tyt-banner-{{ section.id }} button:focus-visible,
  #tyt-banner-{{ section.id }} a:focus-visible { outline:3px solid #dc2626; outline-offset:-3px; }
  @media (max-width:749px) {
    #tyt-banner-{{ section.id }} .tyt-banner__image-link { aspect-ratio:var(--tyt-banner-mobile-ratio); }
    #tyt-banner-{{ section.id }} .tyt-banner__arrow { width:34px; height:34px; font-size:18px; }
    #tyt-banner-{{ section.id }} .tyt-banner__arrow--prev { left:6px; }
    #tyt-banner-{{ section.id }} .tyt-banner__arrow--next { right:6px; }
  }
  @media (prefers-reduced-motion:reduce) { #tyt-banner-{{ section.id }} .tyt-banner__track { transition:none; } }
</style>
<script>
(function () {
  const rootId = 'tyt-banner-{{ section.id }}';
  const store = window.TYTBannerInstances = window.TYTBannerInstances || {};
  function init() {
    const root = document.getElementById(rootId);
    if (!root) return;
    if (store[rootId]) store[rootId]();
    const track = root.querySelector('.tyt-banner__track');
    const slides = Array.from(root.querySelectorAll('.tyt-banner__slide'));
    const dots = Array.from(root.querySelectorAll('[data-go]'));
    if (!track || !slides.length) return;
    let index = 0;
    let timer = null;
    let paused = false;
    let downX = null;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const autoplay = root.dataset.autoplay === 'true' && !reduceMotion && slides.length > 1;
    const delay = Number(root.dataset.interval) || 8000;
    function go(next) {
      index = (next + slides.length) % slides.length;
      track.style.transform = `translateX(-${index * 100}%)`;
      slides.forEach((slide, i) => {
        if (i === index) { slide.removeAttribute('inert'); slide.setAttribute('aria-hidden', 'false'); }
        else { slide.setAttribute('inert', ''); slide.setAttribute('aria-hidden', 'true'); }
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === index);
        dot.setAttribute('aria-current', i === index ? 'true' : 'false');
      });
    }
    function stop() { if (timer) clearInterval(timer); timer = null; }
    function play() { stop(); if (autoplay && !paused) timer = setInterval(() => go(index + 1), delay); }
    function next() { go(index + 1); play(); }
    function prev() { go(index - 1); play(); }
    const cleanups = [];
    function on(node, event, cb) { if (!node) return; node.addEventListener(event, cb); cleanups.push(() => node.removeEventListener(event, cb)); }
    on(root.querySelector('[data-prev]'), 'click', prev);
    on(root.querySelector('[data-next]'), 'click', next);
    dots.forEach((dot, i) => on(dot, 'click', () => { go(i); play(); }));
    on(root, 'mouseenter', () => { paused = true; stop(); });
    on(root, 'mouseleave', () => { paused = false; play(); });
    on(root, 'focusin', () => { paused = true; stop(); });
    on(root, 'focusout', (event) => { if (!root.contains(event.relatedTarget)) { paused = false; play(); } });
    on(document, 'visibilitychange', () => { if (document.hidden) stop(); else play(); });
    on(track, 'touchstart', event => { downX = event.touches[0]?.clientX ?? null; }, {passive:true});
    on(track, 'touchend', event => { if (downX === null) return; const x = event.changedTouches[0]?.clientX ?? downX; if (Math.abs(x - downX) > 40) { x < downX ? next() : prev(); } downX = null; }, {passive:true});
    const selectHandler = event => { if (event.detail?.sectionId === '{{ section.id }}') { const blockId = event.detail.blockId; const block = slides.find(slide => slide.dataset.blockId === blockId); if (block) go(slides.indexOf(block)); paused = true; stop(); } };
    on(document, 'shopify:block:select', selectHandler);
    go(0); play();
    store[rootId] = () => { stop(); cleanups.forEach(fn => fn()); };
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, {once:true}); else init();
  document.addEventListener('shopify:section:load', event => { if (event.detail?.sectionId === '{{ section.id }}') init(); });
  document.addEventListener('shopify:section:unload', event => { if (event.detail?.sectionId === '{{ section.id }}' && store[rootId]) store[rootId](); });
})();
</script>
{% schema %}
{
  "name": "TYT Homepage Banner",
  "settings": [
    {"type":"text","id":"accessibility_label","label":"Carousel description","default":"TYT featured products"},
    {"type":"checkbox","id":"autoplay","label":"Auto-rotate slides","default":true},
    {"type":"range","id":"interval","label":"Seconds per slide","min":3,"max":15,"step":1,"unit":"s","default":8},
    {"type":"checkbox","id":"show_arrows","label":"Show arrows","default":true},
    {"type":"checkbox","id":"show_dots","label":"Show slide dots","default":true},
    {"type":"select","id":"desktop_ratio","label":"Desktop image ratio","options":[{"value":"16/6","label":"16:6"},{"value":"16/7","label":"16:7"},{"value":"16/8","label":"16:8"},{"value":"2/1","label":"2:1"},{"value":"auto","label":"Natural (not recommended with mixed sizes)"}],"default":"16/7"},
    {"type":"select","id":"mobile_ratio","label":"Mobile image ratio","options":[{"value":"4/5","label":"4:5"},{"value":"1/1","label":"1:1"},{"value":"5/4","label":"5:4"},{"value":"16/9","label":"16:9"}],"default":"1/1"},
    {"type":"range","id":"max_width","label":"Maximum banner width","min":1200,"max":2400,"step":100,"unit":"px","default":2400},
    {"type":"color","id":"arrow_color","label":"Arrow color","default":"#FFFFFF"},
    {"type":"color","id":"dot_color","label":"Dot color","default":"#171717"}
  ],
  "blocks": [
    {"type":"slide","name":"Banner slide","settings":[
      {"type":"image_picker","id":"image","label":"Desktop banner image"},
      {"type":"image_picker","id":"mobile_image","label":"Mobile banner image (optional)"},
      {"type":"text","id":"desktop_asset","label":"Desktop theme image filename","info":"Fallback when no desktop image is selected."},
      {"type":"text","id":"mobile_asset","label":"Mobile theme image filename","info":"Fallback mobile image stored in theme assets."},
      {"type":"text","id":"image_alt","label":"Image description (alt text)"},
      {"type":"url","id":"link","label":"Destination link"},
      {"type":"text","id":"link_label","label":"Accessible link label","default":"View featured product"}
    ]}
  ],
  "max_blocks": 10,
  "presets": [
    {"name":"TYT Homepage Banner","blocks":[{"type":"slide"},{"type":"slide"},{"type":"slide"},{"type":"slide"}]}
  ]
}
{% endschema %}
