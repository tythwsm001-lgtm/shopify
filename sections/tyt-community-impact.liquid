
{% comment %}
  TYT Community & Impact V2
  Shopify Dawn 15.3.0

  Features:
  - Two images for each event
  - Upcoming / Completed status
  - Event date and location
  - Single event featured layout
  - Multiple events card layout
  - Editable blocks in Theme Editor
{% endcomment %}

<section
  id="tyt-community-{{ section.id }}"
  class="tyt-community"
  style="
    --tc-bg: {{ section.settings.background_color }};
    --tc-card-bg: {{ section.settings.card_background }};
    --tc-text: {{ section.settings.text_color }};
    --tc-accent: {{ section.settings.accent_color }};
    --tc-gap: {{ section.settings.card_gap }}px;
    --tc-cols: {{ section.settings.desktop_columns }};
    --tc-top: {{ section.settings.padding_top }}px;
    --tc-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="tyt-community__container">

    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subtitle != blank %}
      <header class="tyt-community__heading">

        {% if section.settings.eyebrow != blank %}
          <span class="tyt-community__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </span>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading | escape }}</h2>
        {% endif %}

        {% if section.settings.subtitle != blank %}
          <p>{{ section.settings.subtitle | escape }}</p>
        {% endif %}

      </header>
    {% endif %}

    {% assign event_count = section.blocks.size %}

    {% if event_count > 0 %}

      <div class="tyt-community__grid{% if event_count == 1 %} tyt-community__grid--featured{% endif %}">

        {% for block in section.blocks %}

          {% liquid
            assign event_image = block.settings.image
            assign support_image = block.settings.support_image
            assign event_link = block.settings.link
            assign event_title = block.settings.title

            assign event_alt = block.settings.image_alt
            if event_alt == blank
              assign event_alt = event_title
            endif

            assign support_alt = block.settings.support_image_alt
            if support_alt == blank
              assign support_alt = 'TYT supporting the community event'
            endif
          %}

          <article
            class="tyt-community__card"
            {{ block.shopify_attributes }}
          >

            <div class="tyt-community__card-layout">

              <!-- Event Images -->
              <div class="tyt-community__media">

                <div class="tyt-community__main-image">

                  {% if event_image != blank %}
                    {{
                      event_image
                      | image_url: width: 1400
                      | image_tag:
                        loading: 'lazy',
                        widths: '360, 540, 750, 990, 1200, 1400',
                        sizes: '(min-width: 990px) 45vw, (min-width: 750px) 50vw, 100vw',
                        alt: event_alt,
                        class: 'tyt-community__poster'
                    }}
                  {% else %}
                    {{ 'image' | placeholder_svg_tag: 'tyt-community__placeholder' }}
                  {% endif %}

                </div>

                {% if support_image != blank %}
                  <div class="tyt-community__support-image">
                    {{
                      support_image
                      | image_url: width: 1100
                      | image_tag:
                        loading: 'lazy',
                        widths: '240, 360, 540, 750, 1100',
                        sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw',
                        alt: support_alt,
                        class: 'tyt-community__support-photo'
                    }}
                  </div>
                {% endif %}

              </div>

              <!-- Event Content -->
              <div class="tyt-community__content">

                <div class="tyt-community__meta">

                  {% if block.settings.status == 'upcoming' %}
                    <span class="tyt-community__status tyt-community__status--upcoming">
                      UPCOMING EVENT
                    </span>
                  {% elsif block.settings.status == 'completed' %}
                    <span class="tyt-community__status tyt-community__status--completed">
                      EVENT RECAP
                    </span>
                  {% endif %}

                  {% if block.settings.category != blank %}
                    <span class="tyt-community__category">
                      {{ block.settings.category | escape }}
                    </span>
                  {% endif %}

                </div>

                {% if event_title != blank %}
                  <h3>{{ event_title | escape }}</h3>
                {% endif %}

                {% if block.settings.event_name != blank %}
                  <p class="tyt-community__event-name">
                    {{ block.settings.event_name | escape }}
                  </p>
                {% endif %}

                {% if block.settings.event_date != blank or block.settings.event_location != blank %}

                  <div class="tyt-community__event-info">

                    {% if block.settings.event_date != blank %}
                      <div class="tyt-community__info-item">
                        <svg viewBox="0 0 24 24" fill="none"
                          stroke="currentColor" stroke-width="1.8"
                          stroke-linecap="round" stroke-linejoin="round"
                          aria-hidden="true">
                          <rect x="3" y="5" width="18" height="16" rx="2"/>
                          <path d="M16 3v4M8 3v4M3 10h18"/>
                        </svg>
                        <span>
                          {{ block.settings.event_date | escape }}
                        </span>
                      </div>
                    {% endif %}

                    {% if block.settings.event_location != blank %}
                      <div class="tyt-community__info-item">
                        <svg viewBox="0 0 24 24" fill="none"
                          stroke="currentColor" stroke-width="1.8"
                          stroke-linecap="round" stroke-linejoin="round"
                          aria-hidden="true">
                          <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0z"/>
                          <circle cx="12" cy="10" r="2.5"/>
                        </svg>
                        <span>
                          {{ block.settings.event_location | escape }}
                        </span>
                      </div>
                    {% endif %}

                  </div>

                {% endif %}

                {% if block.settings.description != blank %}
                  <p class="tyt-community__description">
                    {{ block.settings.description | escape | newline_to_br }}
                  </p>
                {% endif %}

                {% if event_link != blank and block.settings.button_label != blank %}

                  <a
                    href="{{ event_link }}"
                    class="tyt-community__readmore"
                  >
                    {{ block.settings.button_label | escape }}
                    <span aria-hidden="true">&rarr;</span>
                  </a>

                {% endif %}

              </div>

            </div>

          </article>

        {% endfor %}

      </div>

    {% endif %}

    {% if section.settings.view_all_link != blank %}
      <div class="tyt-community__footer">
        <a href="{{ section.settings.view_all_link }}">
          {{ section.settings.view_all_label | escape }}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    {% endif %}

  </div>
</section>

<style>
  #tyt-community-{{ section.id }} {
    width: 100%;
    background: var(--tc-bg);
    color: var(--tc-text);
    padding: var(--tc-top) 0 var(--tc-bottom);
  }

  #tyt-community-{{ section.id }} *,
  #tyt-community-{{ section.id }} *::before,
  #tyt-community-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #tyt-community-{{ section.id }} .tyt-community__container {
    max-width: 1400px;
    padding: 0 20px;
    margin: 0 auto;
  }

  /* Section Heading */

  #tyt-community-{{ section.id }} .tyt-community__heading {
    text-align: center;
    margin: 0 0 26px;
  }

  #tyt-community-{{ section.id }} .tyt-community__eyebrow {
    display: block;
    color: var(--tc-accent);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    margin-bottom: 8px;
  }

  #tyt-community-{{ section.id }} .tyt-community__heading h2 {
    font-family: var(--font-heading-family);
    font-size: 32px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--tc-text);
    margin: 0 0 8px;
  }

  #tyt-community-{{ section.id }} .tyt-community__heading p {
    font-size: 15px;
    line-height: 1.5;
    color: #666666;
    max-width: 760px;
    margin: 0 auto;
  }

  /* General Grid */

  #tyt-community-{{ section.id }} .tyt-community__grid {
    display: grid;
    grid-template-columns:
      repeat(var(--tc-cols), minmax(0, 1fr));
    gap: var(--tc-gap);
  }

  #tyt-community-{{ section.id }} .tyt-community__card {
    min-width: 0;
    overflow: hidden;
    background: var(--tc-card-bg);
    border-radius: 8px;
  }

  #tyt-community-{{ section.id }} .tyt-community__card-layout {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  /* Two Images */

  #tyt-community-{{ section.id }} .tyt-community__media {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: 100%;
    gap: 0;
    background: #eeeeee;
  }

  #tyt-community-{{ section.id }} .tyt-community__main-image,
  #tyt-community-{{ section.id }} .tyt-community__support-image {
    min-width: 0;
    overflow: hidden;
    position: relative;
  }

  #tyt-community-{{ section.id }} .tyt-community__main-image {
    height: 250px;
  }

  #tyt-community-{{ section.id }} .tyt-community__support-image {
    height: 160px;
  }

  #tyt-community-{{ section.id }} .tyt-community__poster,
  #tyt-community-{{ section.id }} .tyt-community__support-photo {
    display: block;
    width: 100%;
    height: 100%;
  }

  #tyt-community-{{ section.id }} .tyt-community__poster {
    object-fit: contain;
    background: #f0f0f0;
  }

  #tyt-community-{{ section.id }} .tyt-community__support-photo {
    object-fit: cover;
    object-position: center;
  }

  #tyt-community-{{ section.id }} .tyt-community__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Event Content */

  #tyt-community-{{ section.id }} .tyt-community__content {
    min-width: 0;
    flex: 1;
    padding: 22px;
  }

  #tyt-community-{{ section.id }} .tyt-community__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 14px;
  }

  #tyt-community-{{ section.id }} .tyt-community__status {
    display: inline-block;
    padding: 6px 10px;
    border-radius: 3px;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: .4px;
  }

  #tyt-community-{{ section.id }} .tyt-community__status--upcoming {
    background: var(--tc-accent);
    color: #ffffff;
  }

  #tyt-community-{{ section.id }} .tyt-community__status--completed {
    background: #e8e8e8;
    color: #333333;
  }

  #tyt-community-{{ section.id }} .tyt-community__category {
    color: var(--tc-accent);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  #tyt-community-{{ section.id }} .tyt-community__content h3 {
    font-family: var(--font-heading-family);
    color: var(--tc-text);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 10px;
  }

  #tyt-community-{{ section.id }} .tyt-community__event-name {
    color: #555555;
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 14px;
    line-height: 1.5;
  }

  #tyt-community-{{ section.id }} .tyt-community__event-info {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin-bottom: 16px;
  }

  #tyt-community-{{ section.id }} .tyt-community__info-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 13px;
    line-height: 1.5;
    color: #444444;
  }

  #tyt-community-{{ section.id }} .tyt-community__info-item svg {
    width: 17px;
    height: 17px;
    flex: 0 0 17px;
    color: var(--tc-accent);
    margin-top: 1px;
  }

  #tyt-community-{{ section.id }} .tyt-community__description {
    color: #555555;
    font-size: 14px;
    line-height: 1.7;
    margin: 0 0 20px;
  }

  #tyt-community-{{ section.id }} .tyt-community__readmore {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    color: var(--tc-accent);
  }

  #tyt-community-{{ section.id }} .tyt-community__readmore:hover,
  #tyt-community-{{ section.id }} .tyt-community__footer a:hover {
    text-decoration: underline;
  }

  #tyt-community-{{ section.id }} .tyt-community__readmore:focus-visible,
  #tyt-community-{{ section.id }} .tyt-community__footer a:focus-visible {
    outline: 2px solid var(--tc-accent);
    outline-offset: 4px;
  }

  /* Featured Layout: Exactly One Event */

  #tyt-community-{{ section.id }} .tyt-community__grid--featured {
    grid-template-columns: minmax(0, 1fr);
  }

  #tyt-community-{{ section.id }} .tyt-community__grid--featured .tyt-community__card-layout {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: stretch;
  }

  #tyt-community-{{ section.id }} .tyt-community__grid--featured .tyt-community__media {
    grid-template-columns: minmax(0, 1fr) minmax(0, .72fr);
    gap: 6px;
    padding: 6px;
    background: #ededed;
    align-items: stretch;
  }

  #tyt-community-{{ section.id }} .tyt-community__grid--featured .tyt-community__main-image,
  #tyt-community-{{ section.id }} .tyt-community__grid--featured .tyt-community__support-image {
    height: 390px;
  }

  #tyt-community-{{ section.id }} .tyt-community__grid--featured .tyt-community__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 34px;
  }

  #tyt-community-{{ section.id }} .tyt-community__grid--featured .tyt-community__content h3 {
    font-size: 28px;
  }

  #tyt-community-{{ section.id }} .tyt-community__grid--featured .tyt-community__description {
    font-size: 15px;
  }

  /* View All */

  #tyt-community-{{ section.id }} .tyt-community__footer {
    text-align: center;
    margin-top: 24px;
  }

  #tyt-community-{{ section.id }} .tyt-community__footer a {
    color: var(--tc-accent);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
  }

  /* Tablet */

  @media screen and (min-width: 750px) and (max-width: 989px) {
    #tyt-community-{{ section.id }} .tyt-community__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #tyt-community-{{ section.id }} .tyt-community__grid--featured {
      grid-template-columns: minmax(0, 1fr);
    }

    #tyt-community-{{ section.id }} .tyt-community__grid--featured .tyt-community__card-layout {
      grid-template-columns: 1fr 1fr;
    }

    #tyt-community-{{ section.id }} .tyt-community__grid--featured .tyt-community__media {
      grid-template-columns: minmax(0, 1fr);
    }

    #tyt-community-{{ section.id }} .tyt-community__grid--featured .tyt-community__main-image {
      height: 270px;
    }

    #tyt-community-{{ section.id }} .tyt-community__grid--featured .tyt-community__support-image {
      height: 150px;
    }

    #tyt-community-{{ section.id }} .tyt-community__grid--featured .tyt-community__content {
      padding: 24px;
    }

    #tyt-community-{{ section.id }} .tyt-community__grid--featured .tyt-community__content h3 {
      font-size: 23px;
    }
  }

  /* Mobile */

  @media screen and (max-width: 749px) {
    #tyt-community-{{ section.id }} .tyt-community__container {
      padding: 0 12px;
    }

    #tyt-community-{{ section.id }} .tyt-community__heading {
      margin-bottom: 20px;
    }

    #tyt-community-{{ section.id }} .tyt-community__heading h2 {
      font-size: 26px;
    }

    #tyt-community-{{ section.id }} .tyt-community__heading p {
      font-size: 14px;
    }

    #tyt-community-{{ section.id }} .tyt-community__grid,
    #tyt-community-{{ section.id }} .tyt-community__grid--featured {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }

    #tyt-community-{{ section.id }} .tyt-community__grid--featured .tyt-community__card-layout {
      display: flex;
      flex-direction: column;
    }

    #tyt-community-{{ section.id }} .tyt-community__media,
    #tyt-community-{{ section.id }} .tyt-community__grid--featured .tyt-community__media {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      padding: 6px;
      gap: 6px;
    }

    #tyt-community-{{ section.id }} .tyt-community__main-image,
    #tyt-community-{{ section.id }} .tyt-community__grid--featured .tyt-community__main-image {
      height: auto;
      aspect-ratio: 4 / 3;
    }

    #tyt-community-{{ section.id }} .tyt-community__support-image,
    #tyt-community-{{ section.id }} .tyt-community__grid--featured .tyt-community__support-image {
      height: auto;
      aspect-ratio: 16 / 9;
    }

    #tyt-community-{{ section.id }} .tyt-community__content,
    #tyt-community-{{ section.id }} .tyt-community__grid--featured .tyt-community__content {
      display: block;
      padding: 18px 16px 22px;
    }

    #tyt-community-{{ section.id }} .tyt-community__content h3,
    #tyt-community-{{ section.id }} .tyt-community__grid--featured .tyt-community__content h3 {
      font-size: 21px;
    }

    #tyt-community-{{ section.id }} .tyt-community__description,
    #tyt-community-{{ section.id }} .tyt-community__grid--featured .tyt-community__description {
      font-size: 14px;
      line-height: 1.6;
    }
  }
</style>

{% schema %}
{
  "name": "TYT Community & Impact",
  "tag": "section",
  "class": "tyt-community-section",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "BEYOND THE TOW"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "TYT Community & Impact"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Supporting the people, communities, and places that keep us moving."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card spacing",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#F7F7F7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#202020"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#D71920"
    },
    {
      "type": "header",
      "content": "Community archive"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all stories link"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all button text",
      "default": "Explore Our Community"
    }
  ],
  "blocks": [
    {
      "type": "community_event",
      "name": "Community Event",
      "settings": [
        {
          "type": "header",
          "content": "Event photos"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Event poster / main photo"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Main image alt text"
        },
        {
          "type": "image_picker",
          "id": "support_image",
          "label": "Second photo / TYT support"
        },
        {
          "type": "text",
          "id": "support_image_alt",
          "label": "Second image alt text"
        },
        {
          "type": "header",
          "content": "Event details"
        },
        {
          "type": "select",
          "id": "status",
          "label": "Event status",
          "options": [
            {
              "value": "upcoming",
              "label": "Upcoming Event"
            },
            {
              "value": "completed",
              "label": "Completed Event"
            },
            {
              "value": "none",
              "label": "Hide status"
            }
          ],
          "default": "upcoming"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Event category",
          "default": "COMMUNITY CLEANUP"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Event headline",
          "default": "Supporting Our Off-Road Community"
        },
        {
          "type": "text",
          "id": "event_name",
          "label": "Official event name"
        },
        {
          "type": "text",
          "id": "event_date",
          "label": "Event date / time"
        },
        {
          "type": "text",
          "id": "event_location",
          "label": "Event location"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Event description",
          "default": "TYT supports a community-led initiative dedicated to making a positive impact."
        },
        {
          "type": "header",
          "content": "Event link"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Event details URL"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Link text",
          "default": "Event Details"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "TYT Community & Impact",
      "blocks": [
        {
          "type": "community_event",
          "settings": {
            "status": "upcoming",
            "category": "COMMUNITY CLEANUP",
            "title": "Supporting Our Off-Road Community",
            "event_name": "Colorado 4x4 Offroad Event",
            "event_date": "October 24, 2026 · 10:00 AM",
            "event_location": "Littleton, Colorado",
            "description": "TYT is proud to support ZacsTrax and a community-led fundraiser helping remove abandoned cars, ATVs, and campers from wooded areas."
          }
        }
      ]
    }
