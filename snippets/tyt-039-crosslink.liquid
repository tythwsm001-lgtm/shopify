{%- liquid
  assign target_handle = target_handle | default: 'tyt-adjustable-5-in-1-tri-ball-hitch-ball-mount-for-2-5-receiver'
  assign receiver_size = receiver_size | default: '2.5'
  assign ref_sku = ref_sku | default: '039'
  assign ref_link = ref_link | default: '5in1_25in'
  assign linked_hitch = all_products[target_handle]
  assign linked_hitch_image = linked_hitch.featured_image
  if image_index != blank
    assign linked_hitch_image = linked_hitch.images[image_index] | default: linked_hitch.featured_image
  endif
-%}
<style>
  .tyt-039-crosslink {
    margin: 12px 0 16px;
    width: 100%;
  }
  .tyt-039-crosslink__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 44px;
    box-sizing: border-box;
    padding: 6px 12px 6px 6px;
    border: 1px solid #e6d4d5;
    border-radius: 6px;
    background: #fffafa;
    color: #555;
    text-decoration: none;
  }
  .tyt-039-crosslink__link:hover {
    border-color: #b9b9b9;
    background: #f5f5f5;
  }
  .tyt-039-crosslink__link:focus-visible {
    outline: 2px solid #c9252c;
    outline-offset: 3px;
  }
  .tyt-039-crosslink__title {
    flex: 1;
    min-width: 0;
    font-size: 13px;
    line-height: 1.5;
  }
  .tyt-039-crosslink__title strong { color: #202020; font-weight: 600; }
  .tyt-039-crosslink__image {
    display: block;
    flex: 0 0 40px;
    width: 40px;
    height: 40px;
    object-fit: contain;
    background: #fff;
    border-radius: 4px;
  }
  .tyt-039-crosslink__action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    white-space: nowrap;
    font-size: 13px;
    font-weight: 600;
    color: #c9252c;
  }
  .tyt-039-crosslink__link:hover .tyt-039-crosslink__action { text-decoration: underline; }
  .tyt-039-crosslink__link:active { background: #eee; }
  @media screen and (max-width: 749px) {
    .tyt-039-crosslink { margin: 12px 0 16px; }
    .tyt-039-crosslink__link { padding: 6px 10px 6px 6px; gap: 8px; }
  }
</style>

<div class="tyt-039-crosslink">
  <a
    class="tyt-039-crosslink__link"
    href="https://www.tyttowing.com/products/{{ target_handle | escape }}?ref_sku={{ ref_sku | url_encode }}&amp;ref_link={{ ref_link | url_encode }}"
    aria-label="Explore TYT {{ receiver_size | escape }}-inch receiver hitch"
  >
    {%- if linked_hitch_image != blank -%}
      {{ linked_hitch_image | image_url: width: 120 | image_tag: class: 'tyt-039-crosslink__image', widths: '40, 80, 120', sizes: '40px', width: 40, height: 40, loading: 'lazy', alt: '' }}
    {%- endif -%}
    <span class="tyt-039-crosslink__title">Need a <strong>{{ receiver_size | escape }}″ hitch?</strong></span>
    <span class="tyt-039-crosslink__action">View <span aria-hidden="true">→</span></span>
  </a>
</div>
