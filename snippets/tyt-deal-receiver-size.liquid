{%- assign receiver_entries = product.metafields.custom.receiver_size.value -%}
{%- assign receiver_entry = receiver_entries | first -%}
{%- assign receiver_key = receiver_entry.label.value | strip | remove: '"' | remove: '″' | remove: '”' | replace: '2-1/2', '2.5' -%}
{%- if receiver_entries.count == 1 -%}
  {%- if receiver_key == '2' or receiver_key == '2.5' -%}
    {{- receiver_key -}}
  {%- else -%}
    other
  {%- endif -%}
{%- else -%}
  other
{%- endif -%}
