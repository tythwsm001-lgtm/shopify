{% doc %}
  Render second and third levels from the selected Shopify menu.
  @param {link[]} links - Child menu links.
{% enddoc %}
{%- for child_link in links -%}
  {%- if child_link.links != blank -%}
    <li class="tyt-nav__group">
      {%- if child_link.url != '#' and child_link.url != blank -%}
        <a class="tyt-nav__label tyt-nav__group-link" href="{{ child_link.url }}"{% if child_link.current %} aria-current="page"{% endif %}>{{ child_link.title | escape }}</a>
      {%- else -%}
        <p class="tyt-nav__label">{{ child_link.title | escape }}</p>
      {%- endif -%}
      <ul class="list-menu" role="list">
        {%- for grandchild_link in child_link.links -%}
          <li>{% render 'tyt-navigation-item', menu_link: grandchild_link %}</li>
        {%- endfor -%}
      </ul>
    </li>
  {%- else -%}
    <li class="tyt-nav__entry">{% render 'tyt-navigation-item', menu_link: child_link %}</li>
  {%- endif -%}
{%- endfor -%}