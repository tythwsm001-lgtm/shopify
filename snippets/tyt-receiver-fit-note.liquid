{%- liquid
  assign show_receiver_note = always_show | default: false
  assign ball_mount_collections = 'ball-mounts,2-receiver-hitches,2-5-receiver-hitches,dual-ball-hitches,tri-ball-hitches' | split: ','
  if fit_product != blank
    for product_collection in fit_product.collections
      if ball_mount_collections contains product_collection.handle
        assign show_receiver_note = true
        break
      endif
    endfor
  elsif fit_items != blank
    for fit_item in fit_items
      for product_collection in fit_item.product.collections
        if ball_mount_collections contains product_collection.handle
          assign show_receiver_note = true
          break
        endif
      endfor
      if show_receiver_note
        break
      endif
    endfor
  endif
-%}
{%- if show_receiver_note -%}
  {%- capture note_size -%}{% if fit_product != blank %}{% render 'tyt-deal-receiver-size', product: fit_product %}{% endif %}{%- endcapture -%}
  <aside class="tyt-receiver-fit-note"{% if note_size == '2' or note_size == '2.5' %} data-tyt-fit="{{ note_size }}"{% endif %} aria-label="Receiver size reminder">
    <div class="tyt-receiver-fit-note__heading">
      <svg class="tyt-receiver-fit-note__icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="4" width="16" height="16" rx="1"/><path d="M7 12h10m-7-3-3 3 3 3m4-6 3 3-3 3"/></svg>
      <strong>Measure your receiver before ordering</strong>
    </div>
    <p>Measure the <b>inside width and height</b> of your receiver opening. Both must match the size listed for your ball mount.</p>
  </aside>
{%- endif -%}
