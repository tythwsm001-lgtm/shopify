{% doc %}
  Renders the Black Friday bundle builder.
  @param {string} section_id - The host section ID.
  @param {collection} deal_collection - Source of the six featured ball mounts.
{% enddoc %}
{% assign bundle_categories = 'Ball Mount|ball-mounts,Kinetic Recovery Rope|kinetic-rope,Ratchet Straps|ratchet-straps,Hitch Extension|hitch-extenders,Hand Winch|hand-winch,Trailer Jack|trailer-jack' | split: ',' %}
<section class="tyt-builder" aria-labelledby="TYTBuilderTitle-{{ section_id }}">
  <div class="page-width tyt-builder__inner">
    <header class="tyt-builder__header">
      <div>
        <p class="tyt-builder__campaign">BLACK FRIDAY</p>
        <h1 id="TYTBuilderTitle-{{ section_id }}">Build Your Towing Bundle</h1>
        <p>Choose any items you need. Each category is optional.</p>
      </div>
      <nav class="tyt-builder__size-links" aria-label="Shop by receiver size">
        <a class="tyt-builder__individual" data-tyt-fit="2" href="#TYTReceiver-{{ section_id }}-2">Shop 2″ <span aria-hidden="true">↓</span></a>
        <a class="tyt-builder__individual" data-tyt-fit="2.5" href="#TYTReceiver-{{ section_id }}-2-5">Shop 2.5″ <span aria-hidden="true">↓</span></a>
      </nav>
    </header>
    <tyt-bundle-builder data-cart-add="{{ routes.cart_add_url }}.js" data-currency="{{ cart.currency.iso_code | default: shop.currency }}" data-locale="{{ request.locale.iso_code }}">
      <form>
        <div class="tyt-builder__grid">
          {% for category in bundle_categories %}
            {% assign category_parts = category | split: '|' %}
            {% if category_parts.last == 'hand-winch' %}
              </div>
              <details class="tyt-builder__extras">
                <summary>Hand Winches &amp; Trailer Jacks <span>Optional</span></summary>
                <div class="tyt-builder__grid tyt-builder__extras-grid">
            {% endif %}
            {% assign category_collection = collections[category_parts.last] %}
            {% assign category_limit = 50 %}
            {% if category_parts.last == 'ball-mounts' %}
              {% assign category_collection = deal_collection %}
              {% assign category_limit = 6 %}
            {% endif %}
            {% assign category_id = section_id | append: '-bundle-' | append: forloop.index %}
            <fieldset class="tyt-builder__slot" data-bundle-category="{{ category_parts.last }}">
              <legend>
                {% if category_parts.last == 'kinetic-rope' %}
                  <span class="tyt-builder__wide-label">Kinetic Recovery Rope</span>
                  <span class="tyt-builder__compact-label">Recovery Rope</span>
                {% else %}
                  {{ category_parts.first | escape }}
                {% endif %}
              </legend>
              <select id="{{ category_id }}-product" aria-label="{{ category_parts.first | escape }}" data-bundle-product disabled>
                <option value="">Skip this item</option>
                {% assign has_default_product = false %}
                {% if category_parts.last == 'hand-winch' or category_parts.last == 'trailer-jack' %}
                  {% assign has_default_product = true %}
                {% endif %}
                {% assign option_groups = 'all' | split: '|' %}
                {% if category_parts.last == 'ball-mounts' %}
                  {% assign option_groups = '2|2.5|other' | split: '|' %}
                {% endif %}
                {% for option_group in option_groups %}
                {%- capture group_options -%}
                {% for bundle_item in category_collection.products limit: category_limit %}
                  {% if option_group != 'all' %}
                    {%- capture option_receiver -%}{%- render 'tyt-deal-receiver-size', product: bundle_item -%}{%- endcapture -%}
                    {% assign option_receiver = option_receiver | strip %}
                    {% if option_receiver != option_group %}{% continue %}{% endif %}
                  {% endif %}
                  {% if bundle_item.available and bundle_item.requires_selling_plan != true %}
                    {% for bundle_variant in bundle_item.variants %}
                      {% assign variant_name = bundle_variant.title | downcase %}
                      {% if category_parts.last == 'ball-mounts' %}
                        {% if variant_name contains ' with ' or variant_name contains ' + ' %}
                          {% continue %}
                        {% endif %}
                      {% endif %}
                      {% if bundle_variant.available and bundle_variant.quantity_rule.min <= 1 %}
                        {% assign preview_image = bundle_item.featured_image %}
                        {%- liquid
                          assign product_label = bundle_item.title | remove_first: 'TYT '
                          case category_parts.last
                            when 'ball-mounts'
                              assign mount_name = product_label | split: ' for ' | first
                              case mount_name
                                when 'Adjustable Trailer Hitch Ball Mount', '22K Adjustable Dual-Ball Hitch'
                                  assign product_label = 'Dual-Ball · Gold'
                                when '22K GTW Adjustable Dual-Ball Hitch'
                                  assign product_label = 'Dual-Ball · Black'
                                when 'Adjustable 5-in-1 Ball Mount'
                                  assign product_label = '5-in-1 Mount'
                              endcase
                            when 'kinetic-rope'
                              assign product_label = product_label | replace: 'Kinetic Recovery Rope Kit', 'Kit' | remove: ' Kinetic Recovery Rope'
                            when 'ratchet-straps'
                              assign product_label = product_label | replace: 'Retractable Ratchet Straps', 'Retractable'
                            when 'hand-winch'
                              assign product_label = product_label | split: ',' | first | replace: '1200LB Boat Trailer Strap Winch with 8M Black Rope', '1,200 lb · Black Rope' | replace: '1600lb Boat Trailer Winch with 8M Red Strap', '1,600 lb · Red Strap' | replace: '600LB Boat Trailer Winch with Black Polyster Strap', '600 lb · Black Strap' | replace: '600LB Boat Trailer Winch with 6M Steel Wire', '600 lb · Steel Cable' | replace: '600LB Boat Trailer Winch with Red Nylon Strap', '600 lb · Red Strap'
                            when 'trailer-jack'
                              assign jack_model = product_label | split: ' – ' | first | split: ' - ' | first
                              case jack_model
                                when '5000 lbs A-Frame Trailer Jack'
                                  assign product_label = '5,000 lb · A-Frame · 15″'
                                when '5000 lbs Weld-On Swivel Trailer Jack'
                                  assign product_label = '5,000 lb · Weld-On Swivel · 15″'
                                when '8000 lbs Square Weld-On Trailer Jack'
                                  assign product_label = '8,000 lb · Square Weld-On · 15″'
                                when '5000 lbs Swivel Trailer Jack'
                                  assign product_label = '5,000 lb · Pipe-Mount Swivel · 10″'
                                when '2000 lbs Swivel Dual-Wheel Trailer Jack'
                                  assign product_label = '2,000 lb · Dual-Wheel Swivel · 12″'
                              endcase
                            when 'hitch-extenders'
                              assign product_label = product_label | split: ',' | first | split: '，' | first | replace: 'Trailer Hitch Extension for 2 inch Receiver Tube Extender', 'Extension · 2″' | replace: 'Trailer Hitch Extension', 'Extension' | replace: 'Hitch Extender for 2" Receiver', 'Extension · 2″'
                              assign product_label = product_label | replace: '-Inch Extension', '″ Extension' | replace: '" Extension', '″ Extension'
                              if product_label == '18″ Extension' and bundle_item.title contains 'Fits 2 inch Receiver'
                                assign product_label = '18″ Extension · 2″'
                              endif
                          endcase
                        -%}
                        <option value="{{ bundle_variant.id }}" data-price="{{ bundle_variant.price }}"{% if bundle_variant.compare_at_price > bundle_variant.price %} data-compare-price="{{ bundle_variant.compare_at_price }}"{% endif %} data-title="{{ bundle_item.title | escape }}"{% if category_parts.last == 'ball-mounts' %} data-receiver="{{ option_group }}"{% endif %}{% if preview_image %} data-image="{{ preview_image | image_url: width: 480 | escape }}"{% endif %}{% unless has_default_product %} selected{% endunless %}>{{ product_label | escape }}</option>
                        {% assign has_default_product = true %}
                        {% break %}
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                {% endfor %}
                {%- endcapture -%}
                {% assign group_options = group_options | strip %}
                {% if group_options != blank %}
                  {% if option_group == 'all' %}
                    {{ group_options }}
                  {% else %}
                    <optgroup label="{% if option_group == 'other' %}Other fitments{% else %}{{ option_group }}″ Receiver{% endif %}">{{ group_options }}</optgroup>
                  {% endif %}
                {% endif %}
                {% endfor %}
              </select>
              {% if category_parts.last == 'hitch-extenders' %}
                <p class="tyt-builder__fit" data-extension-warning role="status" hidden>These hitch extensions fit 2″ receivers only.</p>
              {% endif %}
              <div class="tyt-builder__preview" hidden>
                <img alt="" width="480" height="480">
              </div>
              {% if category_parts.last == 'ball-mounts' %}
                <span class="tyt-fit-badge" data-bundle-fit aria-live="polite" hidden></span>
              {% endif %}
            </fieldset>
          {% endfor %}
                </div>
              </details>
        {% render 'tyt-receiver-fit-note', always_show: true %}
        <p class="tyt-builder__fit">If adding a hitch extension, check its fit and towing rating too.</p>
        <div class="tyt-builder__checkout">
          <output aria-live="polite" class="tyt-builder__totals">
            <span data-total-empty>Select at least one item to see your subtotal.</span>
            <span data-total-values hidden>
              <span class="tyt-builder__subtotal-label">Subtotal</span>
              <span class="tyt-builder__amounts">
                <strong data-total-price></strong>
                <s data-total-compare hidden></s>
                <span data-total-savings hidden></span>
              </span>
            </span>
          </output>
          <button type="submit" disabled>Check Out <span aria-hidden="true">→</span></button>
        </div>
        <p class="tyt-builder__error" role="alert" hidden></p>
        <noscript><p>Enable JavaScript to build your bundle, or shop individual deals below.</p></noscript>
      </form>
    </tyt-bundle-builder>
  </div>
</section>
