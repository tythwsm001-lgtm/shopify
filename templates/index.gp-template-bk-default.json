    "custom_liquid_8L4Ahp": {
      "type": "custom-liquid",
      "name": "tyt-sae-section",
      "settings": {
        "custom_liquid": "<div class=\"tyt-sae-section\">\n  <div class=\"tyt-sae-container\">\n\n    <!-- Section Header -->\n    <div class=\"tyt-sae-heading\">\n\n      <div class=\"tyt-sae-eyebrow\">\n        <svg viewBox=\"0 0 24 24\" fill=\"none\"\n          stroke=\"currentColor\" stroke-width=\"1.8\"\n          stroke-linecap=\"round\" stroke-linejoin=\"round\"\n          aria-hidden=\"true\">\n          <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/>\n          <path d=\"m9 12 2 2 4-4\"/>\n        </svg>\n        <span>TYT QUALITY ASSURANCE</span>\n      </div>\n\n      <h2>SAE-Tested. Built for Real Towing.</h2>\n\n      <p>\n        TYT products undergo testing against applicable SAE standards,\n        reinforcing our commitment to dependable towing performance.\n      </p>\n\n    </div>\n\n    <!-- Three Trust Points -->\n    <div class=\"tyt-sae-features\">\n\n      <!-- Feature 1 -->\n      <div class=\"tyt-sae-feature\">\n\n        <div class=\"tyt-sae-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\"\n            stroke=\"currentColor\" stroke-width=\"1.7\"\n            stroke-linecap=\"round\" stroke-linejoin=\"round\"\n            aria-hidden=\"true\">\n            <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/>\n            <path d=\"m9 12 2 2 4-4\"/>\n          </svg>\n        </div>\n\n        <h3>SAE Standard Testing</h3>\n\n        <p>\n          Tested against applicable SAE requirements.\n        </p>\n      </div>\n\n      <!-- Feature 2 -->\n      <div class=\"tyt-sae-feature\">\n\n        <div class=\"tyt-sae-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\"\n            stroke=\"currentColor\" stroke-width=\"1.7\"\n            stroke-linecap=\"round\" stroke-linejoin=\"round\"\n            aria-hidden=\"true\">\n            <rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/>\n            <path d=\"M9 4.5V3h6v1.5\"/>\n            <path d=\"m8 12 2 2 5-5\"/>\n            <path d=\"M8 18h8\"/>\n          </svg>\n        </div>\n\n        <h3>Performance Evaluated</h3>\n\n        <p>\n          Product performance evaluated through testing.\n        </p>\n      </div>\n\n      <!-- Feature 3 -->\n      <div class=\"tyt-sae-feature\">\n\n        <div class=\"tyt-sae-icon\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\"\n            stroke=\"currentColor\" stroke-width=\"1.7\"\n            stroke-linecap=\"round\" stroke-linejoin=\"round\"\n            aria-hidden=\"true\">\n            <path d=\"M3 7h11v10H3z\"/>\n            <path d=\"M14 10h4l3 3v4h-7z\"/>\n            <circle cx=\"7\" cy=\"18\" r=\"2\"/>\n            <circle cx=\"18\" cy=\"18\" r=\"2\"/>\n          </svg>\n        </div>\n\n        <h3>Built for Real Work</h3>\n\n        <p>\n          Dependable towing solutions for demanding jobs.\n        </p>\n      </div>\n\n    </div>\n\n  </div>\n</div>\n\n<style>\n  .tyt-sae-section {\n    width: 100%;\n    background: #1d1d1d;\n    color: #ffffff;\n    margin: 0;\n    padding: 32px 20px;\n    box-sizing: border-box;\n  }\n\n  .tyt-sae-section *,\n  .tyt-sae-section *::before,\n  .tyt-sae-section *::after {\n    box-sizing: border-box;\n  }\n\n  .tyt-sae-container {\n    max-width: 1400px;\n    margin: 0 auto;\n  }\n\n  .tyt-sae-heading {\n    text-align: center;\n    margin: 0 auto 26px;\n  }\n\n  .tyt-sae-eyebrow {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    color: #e0e0e0;\n    font-size: 12px;\n    font-weight: 600;\n    letter-spacing: 1.4px;\n    margin-bottom: 10px;\n  }\n\n  .tyt-sae-eyebrow svg {\n    width: 19px;\n    height: 19px;\n    flex-shrink: 0;\n  }\n\n  .tyt-sae-heading h2 {\n    color: #ffffff;\n    font-size: 32px;\n    font-weight: 700;\n    line-height: 1.25;\n    margin: 0 0 10px;\n    padding: 0;\n  }\n\n  .tyt-sae-heading > p {\n    max-width: 760px;\n    margin: 0 auto;\n    color: #d0d0d0;\n    font-size: 15px;\n    line-height: 1.6;\n    padding: 0;\n  }\n\n  .tyt-sae-features {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 28px;\n    padding-top: 24px;\n    border-top: 1px solid #444444;\n  }\n\n  .tyt-sae-feature {\n    min-width: 0;\n    text-align: center;\n    padding: 0 12px;\n  }\n\n  .tyt-sae-icon {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    margin-bottom: 12px;\n  }\n\n  .tyt-sae-icon svg {\n    width: 32px;\n    height: 32px;\n    color: #ffffff;\n  }\n\n  .tyt-sae-feature h3 {\n    color: #ffffff;\n    font-size: 17px;\n    font-weight: 700;\n    line-height: 1.35;\n    margin: 0 0 8px;\n    padding: 0;\n  }\n\n  .tyt-sae-feature p {\n    color: #c9c9c9;\n    font-size: 13px;\n    line-height: 1.5;\n    margin: 0;\n    padding: 0;\n  }\n\n  @media screen and (max-width: 749px) {\n    .tyt-sae-section {\n      padding: 24px 14px;\n    }\n\n    .tyt-sae-heading {\n      margin-bottom: 20px;\n    }\n\n    .tyt-sae-heading h2 {\n      font-size: 26px;\n    }\n\n    .tyt-sae-heading > p {\n      font-size: 14px;\n    }\n\n    .tyt-sae-features {\n      grid-template-columns: 1fr;\n      gap: 20px;\n      padding-top: 20px;\n    }\n\n    .tyt-sae-feature {\n      padding: 0 8px;\n    }\n\n    .tyt-sae-icon {\n      margin-bottom: 8px;\n    }\n\n    .tyt-sae-icon svg {\n      width: 28px;\n      height: 28px;\n    }\n\n    .tyt-sae-feature h3 {\n      font-size: 16px;\n      margin-bottom: 5px;\n    }\n  }\n</style>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
    "custom_liquid_gzgKXq": {
      "type": "custom-liquid",
      "name": "about us",
      "settings": {
        "custom_liquid": "{% comment %}\n  TYT About Us\n  Shopify Dawn 15.3.0\n{% endcomment %}\n\n{% assign tyt_about_image = 'https://cdn.shopify.com/s/files/1/0268/5442/4762/files/about_us.jpg?v=1792569721' %}\n\n<section class=\"tyt-about\">\n  <div class=\"tyt-about__container\">\n\n    <div class=\"tyt-about__grid\">\n\n      <!-- Brand Image -->\n      <div class=\"tyt-about__media\">\n        <img\n          src=\"{{ tyt_about_image }}\"\n          alt=\"TYT towing equipment and brand story\"\n          loading=\"lazy\"\n          width=\"900\"\n          height=\"720\"\n          class=\"tyt-about__image\"\n        >\n      </div>\n\n      <!-- Brand Story -->\n      <div class=\"tyt-about__content\">\n\n        <span class=\"tyt-about__eyebrow\">\n          ABOUT TYT\n        </span>\n\n        <h2>\n          Built for the Way You Tow.\n        </h2>\n\n        <p>\n          At TYT, we believe dependable towing equipment\n          should be built for the demands of real life.\n        </p>\n\n        <p>\n          From work trailers and heavy-duty hauling to\n          RV adventures and weekend getaways, we focus\n          on practical design, reliable performance,\n          and exceptional value.\n        </p>\n\n        <p>\n          Our mission is simple: make every towing\n          experience more convenient and confident.\n        </p>\n\n        <a href=\"/collections/all\" class=\"tyt-about__link\">\n          Explore Our Products\n          <span aria-hidden=\"true\">&rarr;</span>\n        </a>\n\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<style>\n  .tyt-about {\n    width: 100%;\n    background: #ffffff;\n    margin: 0;\n    padding: 32px 20px;\n    box-sizing: border-box;\n  }\n\n  .tyt-about *,\n  .tyt-about *::before,\n  .tyt-about *::after {\n    box-sizing: border-box;\n  }\n\n  .tyt-about__container {\n    max-width: 1400px;\n    margin: 0 auto;\n  }\n\n  .tyt-about__grid {\n    display: grid;\n    grid-template-columns: 1